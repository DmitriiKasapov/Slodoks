# Claude Code service files — never versioned, at any nesting level
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claude/
.claude.json
.claude.json.backup
.mcp.json
.vscode/

# WordPress: only our own code is tracked.
# Core lives inside the container and never touches the host.
wp-content/uploads/
wp-content/upgrade/
wp-content/languages/
wp-content/debug.log
wp-content/*.log
wp-content/index.php

# Third-party plugins are installed via wp-admin, not versioned
wp-content/plugins/*

# Bundled/default themes — keep only our custom one
wp-content/themes/*
!wp-content/themes/slodoks/

# Dependencies and build artifacts
node_modules/
vendor/
*.map

# Vite dev-server marker: local runtime state, never deployed.
# dist/ IS committed — the hosting has no Node, so built assets ship with the repo.
.vite-hot

# Environment and local overrides
.env
.env.*
docker-compose.override.yml

# Working notes
/links.txt

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
